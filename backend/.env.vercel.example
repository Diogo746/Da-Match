# Backend Vercel project only. Spring does not load this file automatically.
# Keep Production and Preview keys/databases separate. Never use the H2 PoC.
# Store SUPABASE_DB_URL and APP_SECURITY_JWT_PRIVATE_KEY as Vercel Secrets.
PORT=8080
SPRING_PROFILES_ACTIVE=vercel
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SUPABASE_DB_URL=
APP_SECURITY_CORS_ALLOWED_ORIGINS=
APP_SECURITY_COOKIES_SECURE=true
APP_SECURITY_COOKIES_SAME_SITE=Lax
APP_DB_MAX_POOL_SIZE=2
# C1 reduced startup in the measured candidate; reassess throughput under load.
JAVA_TOOL_OPTIONS=-XX:TieredStopAtLevel=1
APP_SECURITY_JWT_ISSUER=
APP_SECURITY_JWT_AUDIENCE=
APP_SECURITY_JWT_ACTIVE_KEY_ID=
APP_SECURITY_JWT_PRIVATE_KEY=
# Config: JSON object with app.security.jwt.public-keys mapping each kid to
# its Base64 SPKI DER public key. The private key is Base64 PKCS#8 DER.
SPRING_APPLICATION_JSON=
